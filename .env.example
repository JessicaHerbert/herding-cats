# Everything here is optional. The setup wizard writes config.toml, which is
# the normal way to configure the app, and these variables override it when
# they are set. Copy this file to .env only if you want that.

# Where config and data live. Defaults to ~/.herding-cats
# Point this somewhere under /tmp when you want to try the app against
# throwaway data rather than your real herd.
HERD_HOME=

# Google Tasks list id, used only by the google task provider.
# List yours with: gws tasks tasklists list
HERD_TASKLIST=

# Your own address, used by the gmail provider to work out who spoke last in
# a thread. A reply is yours to write when someone else sent the last message
# and you are on the To line rather than Cc.
HERD_EMAIL=
